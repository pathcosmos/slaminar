{
  "name": "slaminar",
  "version": "0.3.0",
  "description": "Intelligent project analyzer and setup tool for Claude Code",
  "type": "module",
  "bin": {
    "slaminar": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm test",
    "version": "echo \"📝 Don't forget to update CHANGELOG.md\" && git add CHANGELOG.md || true",
    "release:patch": "npm version patch -m \"chore(release): v%s\"",
    "release:minor": "npm version minor -m \"chore(release): v%s\"",
    "release:major": "npm version major -m \"chore(release): v%s\""
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "claude-code",
    "project-analyzer",
    "plugin-generator",
    "claude",
    "ai-tooling",
    "cli",
    "scaffolding"
  ],
  "license": "MIT",
  "author": "pathcosmos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathcosmos/slaminar.git"
  },
  "homepage": "https://github.com/pathcosmos/slaminar#readme",
  "bugs": {
    "url": "https://github.com/pathcosmos/slaminar/issues"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.1",
    "chalk": "^5.4.0",
    "cli-table3": "^0.6.5",
    "commander": "^13.0.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
